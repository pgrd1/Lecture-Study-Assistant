{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "readOnly": true,
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 2
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "courseId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "summaryMode": {
      "type": "string",
      "enum": ["none", "core", "standard", "full"]
    },
    "sources": {
      "readOnly": true,
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "readOnly": true,
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "pattern": "^(?![.]{1,2}$)(?!(?:[cC][oO][nN]|[pP][rR][nN]|[aA][uU][xX]|[nN][uU][lL]|[cC][oO][mM][1-9¹²³]|[lL][pP][tT][1-9¹²³]|[cC][oO][nN][iI][nN]\\$|[cC][oO][nN][oO][uU][tT]\\$)[ ]*(?:[.]|$))(?!.*[<>:\"/\\\\|?*\\u0000-\\u001F\\u007F-\\u009F])(?=.{1,180}$)(?=.*[^.\\s].*[.](?:[mM]4[aA]|[mM][pP]3|[wW][aA][vV]|[aA][aA][cC]|[fF][lL][aA][cC]|[mM][pP]4|[pP][dD][fF]|[pP][pP][tT][xX]|[tT][xX][tT]|[mM][dD]|[pP][nN][gG]|[jJ][pP][gG]|[jJ][pP][eE][gG]|[hH][eE][iI][cC])$).+$"
          },
          "mediaType": {
            "type": "string",
            "enum": ["audio", "video", "document", "image"]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967296
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "fileName", "mediaType", "sizeBytes"],
        "additionalProperties": false
      }
    },
    "courseProvisioning": {
      "readOnly": true,
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "allOf": [
            {
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"
            },
            {
              "pattern": "\\S"
            }
          ]
        },
        "professorName": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*$"
        }
      },
      "required": ["id", "name"],
      "additionalProperties": false
    }
  },
  "required": ["protocolVersion", "jobId", "courseId", "createdAt", "summaryMode", "sources"],
  "additionalProperties": false
}

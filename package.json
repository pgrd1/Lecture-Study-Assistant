{
  "name": "lecture-study-assistant",
  "productName": "Lecture Study Assistant",
  "version": "0.1.0",
  "description": "Local-first lecture intake and Obsidian study workflow for Windows.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "package:e2e": "set STUDYAPP_E2E_BUILD=1&& electron-forge package",
    "protocol:export": "vite-node scripts/export-protocol-schemas.ts && biome format --write protocol/schemas",
    "make": "electron-forge make",
    "metadata:build": "vite build --config vite.metadata.config.ts",
    "pretest": "npm run metadata:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run metadata:build",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "music-metadata": "11.15.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@electron-forge/cli": "8.0.0-alpha.10",
    "@electron-forge/maker-squirrel": "8.0.0-alpha.10",
    "@electron-forge/plugin-fuses": "8.0.0-alpha.10",
    "@electron-forge/plugin-vite": "8.0.0-alpha.10",
    "@electron-forge/shared-types": "8.0.0-alpha.10",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/debug": "4.1.13",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "44.1.0",
    "jsdom": "30.0.1",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  }
}
